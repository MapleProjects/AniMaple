<?xml version="1.0" encoding="utf-8"?>
<!-- Icono de estado para la notificación de reproducción (media notification).
     Android 16 (API 36) rechaza la notificación si el small icon no es un
     recurso VÁLIDO de la app: los drawables del sistema (android.R.drawable.*)
     lanzan "Invalid notification (no valid small icon)" y la notificación no
     aparece. Este vector blanco es el estándar para notification icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,5v14l11,-7z" />
</vector>
